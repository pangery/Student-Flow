{
  "name": "studentflow",
  "version": "1.0.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:dev": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "inspector": "node telemetry-dashboard/server.mjs",
    "test": "node --test tests/studyEngine.test.cjs tests/notifications.test.cjs tests/widgetBridge.test.cjs tests/authExpiry.test.cjs tests/textbookSecurity.test.cjs",
    "test:study": "node --test tests/studyEngine.test.cjs",
    "test:notif": "node --test tests/notifications.test.cjs",
    "test:widget": "node --test tests/widgetBridge.test.cjs",
    "test:auth": "node --test tests/authExpiry.test.cjs",
    "test:textbook": "node --test tests/textbookSecurity.test.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.7",
    "@react-navigation/native": "^7.1.17",
    "expo": "^58.0.0",
    "expo-auth-session": "~58.0.14",
    "expo-blur": "~58.0.5",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-notifications": "~58.1.6",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-tcp-socket": "^6.4.3",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/node": "^26.6.3",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-tcp-socket"
        ]
      }
    }
  }
}
